      "boundElements": [],
      "updated": 1772988757002,
      "link": null,
      "locked": false,
      "text": "Health e Events\n- GET /health\n- GET /events/stream (SSE)\nPlans\n- GET /plans\n- GET /plans/:planId\n- POST /plans\n- POST /plans/generate\n- POST /plans/:planId/steps/:stepIndex\n- POST /plans/:planId/execute-next\n- POST /plans/:planId/cancel\n- POST /plans/reconcile\nJobs (video)\n- POST /jobs/transcode\n- POST /jobs/vlc\n- POST /jobs/hls\n- POST /jobs/capture\n- POST /jobs/probe-url\n- POST /jobs/probe\n- GET /jobs\n- GET /jobs/:jobId\n- GET /jobs/:jobId/log\n- POST /jobs/:jobId/cancel\nExec (approvals e sessions)\n- GET /exec/approvals\n- POST /exec/approvals/:approvalId/approve\n- POST /exec/approvals/:approvalId/deny\n- GET /exec/sessions\n- GET /exec/sessions/:sessionId/log\nSchedules\n- GET /schedules\n- GET /schedules/:scheduleId\n- POST /schedules\n- POST /schedules/:scheduleId/pause\n- POST /schedules/:scheduleId/resume\nChat\n- POST /chat\n- GET /sessions/:sessionKey/messages",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Health e Events\n- GET /health\n- GET /events/stream (SSE)\nPlans\n- GET /plans\n- GET /plans/:planId\n- POST /plans\n- POST /plans/generate\n- POST /plans/:planId/steps/:stepIndex\n- POST /plans/:planId/execute-next\n- POST /plans/:planId/cancel\n- POST /plans/reconcile\nJobs (video)\n- POST /jobs/transcode\n- POST /jobs/vlc\n- POST /jobs/hls\n- POST /jobs/capture\n- POST /jobs/probe-url\n- POST /jobs/probe\n- GET /jobs\n- GET /jobs/:jobId\n- GET /jobs/:jobId/log\n- POST /jobs/:jobId/cancel\nExec (approvals e sessions)\n- GET /exec/approvals\n- POST /exec/approvals/:approvalId/approve\n- POST /exec/approvals/:approvalId/deny\n- GET /exec/sessions\n- GET /exec/sessions/:sessionId/log\nSchedules\n- GET /schedules\n- GET /schedules/:scheduleId\n- POST /schedules\n- POST /schedules/:scheduleId/pause\n- POST /schedules/:scheduleId/resume\nChat\n- POST /chat\n- GET /sessions/:sessionKey/messages",
