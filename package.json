{
  "name": "kael",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kael - super agente de video e automacao",
  "scripts": {
    "dev": "tsx src/cli/index.ts server",
    "ui:install": "npm --prefix ui install",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:check": "npm --prefix ui run check",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli/index.js server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.50.7",
    "@mariozechner/pi-ai": "^0.50.7",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "fastify": "^4.29.1",
    "playwright": "^1.58.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
