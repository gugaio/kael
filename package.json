{
  "name": "kael",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kael - super agente de video e automacao",
  "scripts": {
    "dev": "tsx src/cli/index.ts server",
    "ui:install": "npm --prefix ui install",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:check": "npm --prefix ui run check",
    "clark:dev": "npm --prefix apps/clark run dev",
    "clark:doctor": "npm --prefix apps/clark run doctor",
    "clark:build": "npm --prefix apps/clark run build",
    "clark:check": "npm --prefix apps/clark run check",
    "clark:test": "npm --prefix apps/clark run test",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli/index.js server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:smoke:browser": "KAEL_BROWSER_SMOKE=1 vitest run src/tools/browser/service.smoke.test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.50.7",
    "@mariozechner/pi-ai": "^0.50.7",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "fastify": "^4.29.1",
    "playwright": "^1.58.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
