{
  "name": "clark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clark edge client local para execucao de capabilities via WebSocket outbound",
  "bin": {
    "clark": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts daemon",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli/index.js daemon",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "pino": "^9.9.5",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
