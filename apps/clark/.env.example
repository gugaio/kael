CLARK_SERVER_URL=ws://127.0.0.1:8787/ws
CLARK_CLIENT_ID=clark-local
CLARK_CLIENT_NAME=Clark Local Notebook
CLARK_HEARTBEAT_INTERVAL_MS=15000
CLARK_RECONNECT_BASE_DELAY_MS=1000
CLARK_RECONNECT_MAX_DELAY_MS=30000
CLARK_TASK_TIMEOUT_MS=15000
CLARK_HTTP_ALLOWLIST=localhost,127.0.0.1,internal.example.com
CLARK_HTTP_TIMEOUT_MS=5000
CLARK_HTTP_MAX_BYTES=65536
CLARK_CONFIG_PATH=./clark.config.json
