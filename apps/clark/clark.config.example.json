{
  "providers": {
    "youbora": {
      "kind": "mcp-http-bridge",
      "url": "https://youbora-mcp.apps.tsuru.gcp.i.globo/mcp",
      "enabled": true,
      "timeoutMs": 5000
    }
  },
  "httpProfiles": {
    "traceview": {
      "baseUrl": "https://traceview.example.com",
      "allowedMethods": ["GET"],
      "defaultHeaders": {
        "x-api-token": "${env:TRACEVIEW_API_TOKEN}"
      }
    }
  },
  "capabilities": [
    {
      "name": "youbora.metrics.get",
      "description": "Consulta metricas agregadas de QoE no Youbora",
      "provider": "youbora",
      "tool": "get_metrics",
      "requiresApproval": false
    },
    {
      "name": "youbora.rawdata.get",
      "description": "Consulta sessoes brutas no Youbora",
      "provider": "youbora",
      "tool": "get_rawdata",
      "requiresApproval": false
    },
    {
      "name": "youbora.events.get",
      "description": "Consulta eventos de player no Youbora",
      "provider": "youbora",
      "tool": "get_events",
      "requiresApproval": false
    },
    {
      "name": "youbora.filters.help",
      "description": "Descreve filtros e dimensoes disponiveis no Youbora",
      "provider": "youbora",
      "tool": "get_filter_help",
      "requiresApproval": false
    },
    {
      "name": "youbora.metrics.help",
      "description": "Descreve metricas disponiveis no Youbora",
      "provider": "youbora",
      "tool": "get_metrics_help",
      "requiresApproval": false
    }
  ]
}
