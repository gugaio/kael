# Required: generate with `openssl rand -hex 32`.
KAEL_API_AUTH_TOKEN=replace-with-a-long-random-token

# The Compose port remains bound to 127.0.0.1. Put Caddy/Nginx in front of it
# in the next deployment increment, or use an SSH tunnel for initial access.
KAEL_PORT=3210

# Match the Linux user that owns ./workspace on the VPS.
KAEL_UID=1000
KAEL_GID=1000

# Engine: use simple for a local smoke test; pi or hybrid require the API key.
KAEL_ENGINE_MODE=hybrid
KAEL_PI_API_KEY=
KAEL_PI_MODEL=gpt-5.5

# Keep shell execution conservative on a server.
KAEL_EXEC_SECURITY=allowlist
KAEL_EXEC_ASK=on-miss
KAEL_MAX_CONCURRENT_JOBS=2
